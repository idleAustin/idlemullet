{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idlemullet",
  "compatibility_date": "2024-09-23",
  // The homepage is static: Cloudflare serves dist/ directly, no Worker script needed.
  // Unknown paths fall back to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Cloudflare sends each request to the most specific matching route, so
  // idlemullet.com/idle-distribution* stays with the idle-distribution worker (idlemullet-router)
  // and everything else on the domain lands here.
  "routes": [
    { "pattern": "idlemullet.com/*", "zone_name": "idlemullet.com" },
    { "pattern": "www.idlemullet.com/*", "zone_name": "idlemullet.com" }
  ]
}
